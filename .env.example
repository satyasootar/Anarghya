# Remote Event Data Endpoint
# Options:
# 1. Dev Vercel/Cloudflare deployment (Recommended for dynamic updates without rebuilds):
#    VITE_EVENT_DATA_URL=https://your-data-project.vercel.app/eventData.json
#
# 2. GitHub Raw or GitHub Gist (Make sure CORS is supported, e.g. raw gist):
#    VITE_EVENT_DATA_URL=https://gist.githubusercontent.com/<username>/<gist_id>/raw/eventData.json
#
# 3. Direct relative path on the same cPanel server (editable directly via cPanel File Manager):
#    VITE_EVENT_DATA_URL=/eventData.json
#
# If left unset, it automatically defaults to: /eventData.json
VITE_EVENT_DATA_URL=/eventData.json
